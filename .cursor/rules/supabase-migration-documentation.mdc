Step 5: Implement Specific Integrity Checks
Client Deletion Check
// In SupabaseStorageService
@override
Future<bool> canDeleteClient(String clientId) async {
  // Get client UUID from client_id
  final clientRecord = await _supabase
    .from('clients')
    .select('id')
    .eq('client_id', clientId)
    .single();
    
  if (clientRecord == null) return true; // Client doesn't exist
  
  // Check for related invoices
  final invoices = await _supabase
    .from('invoices')
    .select('id')
    .eq('client_id', clientRecord['id'])
    .limit(1);
    
  return invoices.isEmpty;
}
