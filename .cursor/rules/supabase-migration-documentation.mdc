    .from('catalog_items')
    .select('id')
    .eq('organization_id', orgId)
    .eq('title', title)
    .limit(1);
    
  return items.isEmpty;
}
Step 6: Implement Transaction Handling
Create Invoice with Items
// In SupabaseStorageService
@override
Future<bool> createInvoice(Invoice invoice) async {
  try {
    final orgId = await _getCurrentOrganizationId();
    
    // Find client UUID from client_id
    final clientRecord = await _supabase
      .from('clients')
      .select('id')
      .eq('client_id', invoice.client.clientId)
      .single();
      
    if (clientRecord == null) return false;
    
    // Begin transaction
    final result = await _supabase.rpc('create_invoice_with_items', {
      'p_org_id': orgId,
      'p_client_id': clientRecord['id'],
      'p_invoice_id': invoice.invoiceId,
      'p_issue_date': invoice.issueDate.toIso8601String(),
      'p_due_date': invoice.dueDate.toIso8601String(),
      'p_subtotal': invoice.subtotal,
      'p_tax_rate': invoice.taxRate,
      'p_tax_amount': invoice.taxAmount,
      'p_total': invoice.total,
      'p_status': invoice.status.toString().split('.').last,
      'p_template_name': invoice.templateName,
      'p_notes': invoice.notes,
      'p_items': invoice.items.map((item) => {
        'title': item.title,
        'description': item.description,
        'quantity': item.quantity,
        'unit_price': item.amount,
        'amount': item.amount * item.quantity
      }).toList()
    });
    
    return result != null;
  } catch (e) {
    debugPrint('Error creating invoice: $e');
    return false;
  }
}
Step 7: Data Migration Utility
class DataMigrationUtility {
  final SharedPreferencesStorageService _sharedPrefs;
  final SupabaseStorageService _supabase;
  
  DataMigrationUtility(this._sharedPrefs, this._supabase);
  
  Future<MigrationResult> migrateAllData() async {
    try {
      // 1. Create organization
      final companyInfo = await _sharedPrefs.getCompanyInfo();
      if (companyInfo == null) {
        return MigrationResult(success: false, message: 'No company info found');
      }
      
      final orgId = await _migrateCompanyInfo(companyInfo);
      
      // 2. Migrate clients
      final clients = await _sharedPrefs.getClients();
      final clientMappings = await _migrateClients(clients, orgId);
      
      // 3. Migrate catalog items
      final catalogItems = await _sharedPrefs.getCatalogItems();
      final catalogMappings = await _migrateCatalogItems(catalogItems, orgId);
      
      // 4. Migrate invoices with relationships
      final invoices = await _sharedPrefs.getInvoices();
      await _migrateInvoices(invoices, clientMappings, catalogMappings, orgId);
      
      // 5. Migrate settings
      final settings = await _sharedPrefs.getInvoiceSettings();
      if (settings != null) {
        await _migrateInvoiceSettings(settings, orgId);
      }
      
      return MigrationResult(
        success: true, 
        message: 'Migration completed successfully'
      );
    } catch (e) {
      return MigrationResult(
        success: false, 
        message: 'Migration failed: ${e.toString()}'
      );
    }
  }
  
  // Implementation of individual migration methods...
}
Step 8: UI Updates for Asynchronous Operations
// Example: Invoice list screen
class InvoiceListScreen extends StatefulWidget {
  @override
  _InvoiceListScreenState createState() => _InvoiceListScreenState();
}

class _InvoiceListScreenState extends State<InvoiceListScreen> {
  final StorageService _storage = GetIt.instance<StorageService>();
  List<Invoice>? _invoices;
  bool _isLoading = true;
  String? _error;
  
  @override
  void initState() {
    super.initState();
    _loadInvoices();
  }
  
  Future<void> _loadInvoices() async {
    setState(() {
      _isLoading = true;
      _error = null;
    });
    
    try {
      final invoices = await _storage.getInvoices();
      setState(() {
        _invoices = invoices;
        _isLoading = false;
      });
    } catch (e) {
      setState(() {
        _error = 'Failed to load invoices: ${e.toString()}';
        _isLoading = false;
      });
    }
  }
  
  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return Center(child: CircularProgressIndicator());
    }
    
    if (_error != null) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(_error!),
            ElevatedButton(
              onPressed: _loadInvoices,
              child: Text('Retry'),
            ),
          ],
        ),
      );
    }
    
    if (_invoices == null || _invoices!.isEmpty) {
      return Center(
        child: Text('No invoices found. Create your first invoice!'),
      );
    }
    
    return ListView.builder(
      itemCount: _invoices!.length,
      itemBuilder: (context, index) {
        final invoice = _invoices![index];
        return InvoiceCard(invoice: invoice);
      },
    );
  }
}
Phased Migration Approach
Phase 1: Setup and Initial Testing
